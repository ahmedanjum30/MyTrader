# Copy to .env and fill in. Never commit .env.

# Alpaca API credentials
# Get these from: https://app.alpaca.markets/account/profile
# (paper account uses different keys than live; both shown on dashboard)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper trading by default (true). Set to false for LIVE trading.
ALPACA_PAPER=true

# Hard guardrail. Must be "true" to permit live API connection.
# Default false even when ALPACA_PAPER=false — double safety.
ALLOW_LIVE=false
