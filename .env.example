# Copy to .env and fill in. Never commit .env.

# IBKR Gateway / TWS connection
# Paper TWS:     127.0.0.1:7497
# Paper Gateway: 127.0.0.1:4002
# Live TWS:      127.0.0.1:7496
# Live Gateway:  127.0.0.1:4001
IBKR_HOST=127.0.0.1
# 4002 = Gateway-paper (recommended for bots)
# 7497 = TWS-paper
# 4001 = Gateway-live, 7496 = TWS-live (require ALLOW_LIVE=true below)
IBKR_PORT=4002
IBKR_CLIENT_ID=17

# Your paper account ID, e.g. DU1234567 (live IDs start with U)
IBKR_ACCOUNT=

# Hard guardrail. Set to "true" only after you've read README "Going live".
ALLOW_LIVE=false
